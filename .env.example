# =====================================================================
#  ترتیب استفاده از ارائه‌دهنده‌های هوش مصنوعی (هر کدام کلید داشته باشد، جلوتر است)
#
#    ۱. MISTRAL_API_KEY      ← پلن Free بدون کارت بانکی، فارسی در فهرست زبان‌ها
#    ۲. GROQ_API_KEY         ← استنتاج سریع، سازگار با OpenAI
#    ۳. GEMINI_API_KEY       ← پلن رایگان Google AI Studio
#    ۴. AI_API_KEY           ← سرویس عمومی سازگار با OpenAI (آخرین تلاش)
#
#  چرا چند تا؟ سرویس عمومی کلیدش با اپ‌های دیگر هم‌استفاده می‌شود و وقتی ظرفیتش
#  پر شود خطای 503 «طلب در صف پر است» می‌دهد. با یک کلید اختصاصی، چت حتی وقتی
#  سرویس عمومی شلوغ است کار می‌کند. همه‌ی کلیدها فقط در ورسل ست می‌شوند
#  (Project → Settings → Environment Variables).
# =====================================================================

# ===== ۱) Mistral (سازگار با OpenAI) =====
MISTRAL_API_KEY=
MISTRAL_BASE_URL=https://api.mistral.ai/v1
MISTRAL_MODEL=mistral-small-latest

# ===== ۲) Groq (سازگار با OpenAI) =====
GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_MODEL=llama-3.3-70b-versatile

# ===== ۳) Gemini (ساختار درخواست متفاوت) =====
# اگر GEMINI_MODEL خالی باشد، دو مدل پیش‌فرض به ترتیب امتحان می‌شوند
GEMINI_API_KEY=
GEMINI_MODEL=

# ===== ۴) سرویس عمومی سازگار با OpenAI =====
AI_API_KEY=YOUR_AI_API_KEY
AI_BASE_URL=https://top-tools-ai.com/api/v1
# مدل اصلی. اندازه‌گیری در ۲۰۲۶-۱۰-۱۱ (پاسخ تک‌توکنی):
#   DeepSeek-V4.1-Flash ~۲۰s  ← پیش‌فرض (سریع‌ترین اندازه‌گیری‌شده)
#   Step-5-Preview     ~۲۳s
#   MiniMax-M3         ~۵۲s
#   Top-Tools-Ai       ~۷۸s  ← کلید روی همین مدل هم کار می‌کند، ولی از سقف ۶۰s فانکشن ورسل
#                              رد می‌شود؛ فقط با تنظیم دستی AI_MODEL فعال می‌شود
AI_MODEL=DeepSeek-V4.1-Flash
# اگر مدل اصلی خیلی زود خطا داد، این‌ها به ترتیب امتحان می‌شوند
# (نکته: سرویس روی هر کلید هم‌زمانی محدودی دارد — خطای 429 — و درخواست قطع‌شده را
#  تا انتها پردازش می‌کند؛ پس در رفتار عادی فقط مدل اصلی اجرا می‌شود)
AI_FALLBACK_MODELS=Step-5-Preview,GLM-5.3-Flash
AI_MAX_TOKENS=700
# بودجه‌ی زمانی کل (ثانیه) — باید کمتر از maxDuration فایل api/ai_chat.py باشد
AI_TOTAL_BUDGET=55
AI_FIRST_ATTEMPT=45
