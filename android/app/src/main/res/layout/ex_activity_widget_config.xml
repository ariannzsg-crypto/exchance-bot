<?xml version='1.0' encoding='utf-8'?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/ex_config_title"
        android:textSize="19sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/ex_config_hint"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="@string/ex_config_pick"
        android:textSize="12sp" />

    <EditText
        android:id="@+id/ex_config_search"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:hint="@string/ex_config_search"
        android:imeOptions="actionSearch"
        android:inputType="text"
        android:maxLines="1" />

    <TextView
        android:id="@+id/ex_config_status"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:text="@string/ex_config_loading"
        android:textSize="12sp" />

    <ListView
        android:id="@+id/ex_config_list"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="6dp"
        android:divider="#22000000"
        android:dividerHeight="1dp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:orientation="horizontal">

        <EditText
            android:id="@+id/ex_config_high"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:hint="@string/ex_config_high"
            android:inputType="numberDecimal"
            android:maxLines="1" />

        <EditText
            android:id="@+id/ex_config_low"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:layout_marginLeft="8dp"
            android:hint="@string/ex_config_low"
            android:inputType="numberDecimal"
            android:maxLines="1" />
    </LinearLayout>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:text="@string/ex_config_alert_hint"
        android:textSize="11sp" />

    <Button
        android:id="@+id/ex_config_save"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:text="@string/ex_config_save" />
</LinearLayout>
